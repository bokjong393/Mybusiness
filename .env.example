# Copy to .env and fill in. .env is gitignored -- keep it that way.
#
# Practice credentials: https://www.oanda.com/demo-account/tpa/personal_token
# The account id looks like 101-001-1234567-001 (live ids start 001-).

OANDA_API_TOKEN=your_api_token_here
OANDA_ACCOUNT_ID=101-001-0000000-001

# Required, in addition to the config file, before `fxbot live` will run.
# Leave this unset for practice trading.
# FXBOT_ALLOW_LIVE=I_UNDERSTAND_THE_RISK
