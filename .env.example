# ---------------------------------------------------------------
# Ayoka — environment variables
# Copy this file to .env and fill it in. NEVER commit .env.
# ---------------------------------------------------------------

# 1. Your Anthropic API key. Get it at https://console.anthropic.com
#    Set a spend limit in the console BEFORE you launch. Seriously.
ANTHROPIC_API_KEY=sk-ant-...

# 2. Secret used to sign and verify customer licence keys.
#    Generate one with:  node scripts/mint-license.mjs --new-secret
#    If you ever change this, every licence you already sold stops working.
LICENSE_SECRET=change-me-to-a-long-random-string

# 3. Model. Leave as-is unless you have a reason to change it.
ANTHROPIC_MODEL=claude-opus-5

# 4. Spend guardrails (the thing that stops a viral post bankrupting you).
#    DAILY_OUTPUT_TOKEN_BUDGET is a hard stop across ALL users per day.
#    At Opus 5 pricing (~$25 / 1M output tokens), 200000 tokens ~= $5/day max.
DAILY_OUTPUT_TOKEN_BUDGET=200000
FREE_RUNS_PER_DAY_PER_IP=3
PAID_RUNS_PER_DAY_PER_LICENSE=60

# 5. Where the app is served from (used for CORS + links). No trailing slash.
PUBLIC_ORIGIN=http://localhost:3000

# 6. Local dev port
PORT=3000
