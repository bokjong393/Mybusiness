# ─── Client-side (safe to expose; Vite inlines VITE_* into the bundle) ───────
# Anon key is protected by Row Level Security — see supabase/policies.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Turn on AI commentary. Only set this where api/prophecy.js is actually
# deployed (e.g. Vercel) — on a static host the route cannot exist and the app
# uses its built-in commentary instead.
VITE_AI_ENABLED=false

# ─── Server-side ONLY. Never prefix these with VITE_. ───────────────────────
# Prefixing any of these with VITE_ would inline the secret into the browser
# bundle, where anyone can read it.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
